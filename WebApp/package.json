{
  "name": "web-app",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "bunx @angular/cli",
    "start": "bunx @angular/cli serve --poll 2000",
    "start:dev": "bunx @angular/cli serve --configuration development --poll 2000",
    "start:prod": "bunx @angular/cli serve --configuration production --poll 2000",
    "start:open": "bunx @angular/cli serve --open --poll 2000",
    "build": "bunx @angular/cli build",
    "build:dev": "bunx @angular/cli build --configuration development",
    "build:prod": "bunx @angular/cli build --configuration production",
    "build:analyze": "bunx @angular/cli build --configuration production --stats-json && bunx webpack-bundle-analyzer dist/web-app/browser/stats.json",
    "watch": "bunx @angular/cli build --watch --configuration development --poll 2000",
    "watch:prod": "bunx @angular/cli build --watch --configuration production --poll 2000",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:ci": "bun test --coverage",
    "test:debug": "bun test --verbose",
    "lint": "bunx @angular/cli lint",
    "lint:fix": "bunx @angular/cli lint --fix",
    "lint:ci": "bunx @angular/cli lint --format=json --output-file=lint-results.json",
    "format:check": "bunx @biomejs/biome check ./src && bunx prettier --check \"src/**/*.html\"",
    "format:write": "bunx @biomejs/biome check --write ./src && bunx prettier --write \"src/**/*.html\"",
    "format": "bun run format:write",
    "check": "bun run lint && bun run format:check && bun run test:ci",
    "check:fix": "bun run lint:fix && bun run format && bun run test:ci",
    "typecheck": "bunx tsc --noEmit",
    "clean": "rm -rf ./dist ./coverage ./.angular",
    "clean:all": "bun run clean && rm -rf ./node_modules && bun install",
    "prebuild": "bun run clean",
    "prebuild:prod": "bun run check",
    "ci:install": "bun install --frozen-lockfile",
    "ci:clean": "rm -rf ./dist",
    "ci:test": "bun run test:ci",
    "ci:build": "bunx @angular/cli build --configuration production",
    "ci:full": "bun run ci:clean && bun run ci:test && bun run ci:build",
    "docker:build": "docker build -f Dockerfile.production -t webapp-prod . --load",
    "docker:run": "docker run -d -p 127.0.0.1:8080:8080 --name webapp-test webapp-prod",
    "docker:stop": "docker stop webapp-test && docker rm webapp-test",
    "docker:test": "bun run docker:build && bun run docker:run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@ng-icons/bootstrap-icons": "^35.0.1",
    "@ng-icons/core": "^35.0.1",
    "@ng-icons/heroicons": "^35.0.1",
    "@ng-icons/simple-icons": "^35.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.2"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "7.29.8",
    "@isaacs/brace-expansion": "5.0.1",
    "fast-uri": "3.1.5",
    "flatted": "3.4.4",
    "follow-redirects": "1.16.0",
    "immutable": "5.1.9",
    "ip-address": "10.5.0",
    "js-yaml": "4.3.1",
    "launch-editor": "2.14.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "qs": "6.15.3",
    "shell-quote": "1.10.0",
    "tar": "7.5.22",
    "webpack-dev-server": "5.2.6",
    "websocket-driver": "0.7.5"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@angular/localize": "^22.1.2",
    "@biomejs/biome": "2.2.2",
    "@types/bun": "^1.3.14",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.67.0",
    "webpack-bundle-analyzer": "^5.3.1"
  }
}
