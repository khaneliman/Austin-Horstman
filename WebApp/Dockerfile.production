FROM docker.io/library/node:26-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS build

# hadolint ignore=DL3016
RUN npm install --global bun@1.3.14

WORKDIR /usr/src/app

RUN chown node:node /usr/src/app

# Copy package files and install dependencies (including dev deps for build)
COPY --chown=node:node package.json bun.lock ./

USER node

RUN bun install --frozen-lockfile

COPY --chown=node:node . .

RUN bun run ci:build

FROM docker.io/library/nginx:alpine@sha256:db35bfc6b2951e7f8a72db5db120288c127ffaeeb4a6d4b95a26fead017d5913 AS production

COPY --from=build --chown=nginx:nginx /usr/src/app/dist/web-app/browser/ /usr/share/nginx/html/
COPY --chown=nginx:nginx nginx.conf /etc/nginx/nginx.conf

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --output-document=- http://127.0.0.1:8080/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
